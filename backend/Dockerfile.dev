FROM node:20-alpine

WORKDIR /app

# Compilar módulos nativos
RUN apk add --no-cache python3 make g++

RUN npm install -g pnpm

COPY package.json pnpm-lock.yaml .npmrc ./

# Instalar sin scripts para evitar compilación prematura
RUN pnpm install --ignore-scripts

# Compilar bcrypt para Linux Alpine explícitamente
RUN for dir in node_modules/.pnpm/bcrypt@*/node_modules/bcrypt; do \
    (cd "$dir" && npm rebuild bcrypt --build-from-source); \
    done

COPY . .

EXPOSE 3001

CMD ["pnpm", "run", "start:dev"]